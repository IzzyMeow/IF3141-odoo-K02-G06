              sequence="2"/>
    <menuitem id="menu_warkop_stock_approval"
              name="Persetujuan Penyesuaian Stok"
              parent="menu_warkop_inventory"
              action="action_warkop_stock_approval"
              sequence="3"/>
    <menuitem id="menu_warkop_balance"
              name="Saldo Stok Cabang"
              parent="menu_warkop_inventory"
              action="action_warkop_stock_balance"
              sequence="4"/>

