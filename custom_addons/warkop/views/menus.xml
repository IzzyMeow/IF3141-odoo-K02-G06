<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tambahkan web_icon agar muncul di App Dropdown -->
    <menuitem id="menu_warkop_root"
              name="Warkop H. Mahmud"
              web_icon="stock,static/description/icon.png"
              sequence="10"/>

    <!-- Menu Inventori -->
    <menuitem id="menu_warkop_inventory"
              name="Inventori"
              parent="menu_warkop_root"
              sequence="10"/>
    <menuitem id="menu_warkop_stock_report"
